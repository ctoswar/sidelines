# Copy this file to .env and fill in real values. Never commit .env itself.
#
# Every value below is a placeholder — none of them are real.

# Postgres connection string. For the Pi stack this looks like:
#   postgresql://sidelines:<POSTGRES_PASSWORD>@<PI_IP>:5432/sidelines
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Better Auth. Generate a real secret with:
#   node -e "console.log(crypto.randomUUID())"
BETTER_AUTH_SECRET=<generate-a-long-random-string>
BETTER_AUTH_URL=http://localhost:3000

# Public origin of the app (used in QR codes and callback URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where uploaded files (profile pictures, banners) are stored.
UPLOAD_DIR=./var/uploads

# Only used by docker-compose.yml for the local dev database.
POSTGRES_PASSWORD=<choose-a-database-password>
